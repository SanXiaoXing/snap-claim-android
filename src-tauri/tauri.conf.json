{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapClaim Mobile",
  "version": "0.1.0",
  "identifier": "cn.sanxiaoxing.snapclaim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnapClaim",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SanXiaoXing",
    "copyright": "Copyright © 2026 SanXiaoXing. All rights reserved."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://update.sanxiaoxing.cn/snapclaim-android/latest.json"
      ],
      "dialog": false,
      "pubkey": "<~/.tauri/snapclaim-android.key.pub 内容>"
    }
  }
}
