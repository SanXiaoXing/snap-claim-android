<?xml version="1.0" encoding="utf-8"?>
<!-- 启动器小组件列表预览底图（旧系统无 previewLayout 时使用）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="@color/owed_positive_start"
                android:endColor="@color/owed_positive_end"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
